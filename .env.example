# ============================================================
# Contoh environment Gateway Service.
# Salin ke .env lalu isi nilai yang kosong. Jangan commit .env.
# Field tanpa default di app/core/config.py WAJIB diisi, atau app gagal start.
# ============================================================

# ===== App =====
APP_NAME=API Gateway
APP_PORT=9000
DEBUG=true

# ===== Calculation System =====
CALC_SERVICE_URL=http://localhost:5000
CALC_SERVICE_KEY=change-me
# true  = POST /api/calculate mengembalikan hasil dummy (calc-service belum siap)
# false = diteruskan ke calc-service lewat forward()
CALC_STUB_MODE=true

# ===== Database (PostgreSQL) =====
POSTGRES_DB=service_staging_db
POSTGRES_USER=
POSTGRES_PASSWORD=
# Lokal tanpa TLS:
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/service_staging_db?sslmode=disable
# Supabase (session pooler, TLS aktif), contoh bentuk:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ===== Database TLS (diabaikan bila sslmode=disable) =====
DB_SSL_CA_PATH=certs/prod-ca-2021.crt
# false hanya bila hostname cert tidak cocok di Supabase session pooler
DB_SSL_CHECK_HOSTNAME=true
# false = tetap terenkripsi tapi TIDAK terverifikasi. Darurat saja
DB_SSL_VERIFY=true

# ===== Internal =====
INTERNAL_CLEANUP_TOKEN=change-me

# ===== JWT / Auth =====
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Seed =====
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_FULL_NAME=Super Admin
SEED_DEFAULT_USER_PASSWORD=password

# ===== CORS =====
# Daftar origin frontend, dipisah koma tanpa spasi
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000